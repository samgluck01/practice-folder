// This file is kept here for reference/history only. Pushing this repo does
// NOT deploy these rules — they must be pasted into the Firebase console
// (Firestore Database > Rules tab > Publish) to take effect.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowedUser() {
      return request.auth != null &&
        request.auth.token.email in [
          'samgluck2001@gmail.com',
          'ahuvaben@icloud.com'
        ];
    }

    match /tasks/{taskId} {
      allow read: if isAllowedUser();

      allow create: if isAllowedUser()
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.completed == false;

      allow update: if isAllowedUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed'])
        && request.resource.data.completed is bool;

      allow delete: if isAllowedUser();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
